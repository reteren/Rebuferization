{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rebuffer",
  "version": "0.1.0",
  "identifier": "com.reteren.rebuffer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "popup",
        "url": "index.html",
        "title": "Rebuffer",
        "width": 1100,
        "height": 700,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Rebuffer — Settings",
        "width": 960,
        "height": 660,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "center": true,
        "skipTaskbar": true
      },
      {
        "label": "traymenu",
        "url": "traymenu.html",
        "title": "Rebuffer menu",
        "width": 210,
        "height": 132,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": true,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/Rebuffer/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "reteren",
    "copyright": "MIT",
    "shortDescription": "Persistent clipboard history",
    "longDescription": "A fast, persistent clipboard history for Windows. Everything you copy stays for 30 days and comes back with one hotkey.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer/clipboard-history.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
