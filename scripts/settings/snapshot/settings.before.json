{
  "version": 1,
  "hotkey": {
    "binding": "Alt+V",
    "aggressiveMode": false
  },
  "storage": {
    "path": "",
    "retentionDays": 30,
    "maxItemBytes": 268435456,
    "maxStoreBytes": null,
    "notifyWhenFull": true
  },
  "window": {
    "sizeMode": "percent",
    "percentOfMonitor": 40,
    "fixed": {
      "width": 1100,
      "height": 700
    },
    "zoomStep": 1
  },
  "behavior": {
    "autoPaste": false,
    "pasteAsPlainText": false,
    "closeOnCopy": true,
    "launchOnStartup": true,
    "silentStart": true,
    "captureEnabled": true
  },
  "appearance": {
    "showAge": true,
    "formatLabelSize": "medium",
    "animateGifs": true,
    "reduceMotion": false,
    "accent": "#7aa2ff"
  },
  "privacy": {
    "respectClipboardFlags": true,
    "blockedProcesses": [
      "keepass.exe",
      "keepassxc.exe",
      "1password.exe",
      "bitwarden.exe",
      "lastpass.exe",
      "dashlane.exe",
      "protonpass.exe"
    ]
  }
}